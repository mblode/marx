{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-host",
          "value": ".*\\.zone\\.blode\\.co|.*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "buildCommand": "npm run build && npm run build:site",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/marx",
      "destination": "/marx/index.html"
    }
  ]
}
